# Local demo config — used by START-CodePulse.command to create server/.env on first run.
# Port 5050 (not 5000) because macOS AirPlay Receiver occupies port 5000.
PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/codepulse
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/contests/google/callback
