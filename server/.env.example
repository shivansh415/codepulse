# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas — get from Atlas dashboard → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/codepulse?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URLs — comma-separated if you need to allow more than one origin
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Redis (Upstash) — get the full "rediss://..." string from Upstash console → Connect → ioredis
REDIS_URL=

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/contests/google/callback

# NEVER commit the real .env file — this .example file is the only one that belongs in git.
